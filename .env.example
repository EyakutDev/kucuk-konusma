# Kopyala: cp .env.example .env  — sonra değerleri doldur.

# Zorunlu. Üretmek için: openssl rand -hex 32
SESSION_SECRET=
# Zorunlu. Veritabanı şifresi. Üretmek için: openssl rand -hex 16
POSTGRES_PASSWORD=

# Uygulamanın sunucuda dinleyeceği port (varsayılan 3000)
APP_PORT=3000
# Nginx/Caddy gibi bir ters vekil arkasındaysa 1 yap
TRUST_PROXY=0

# --- Sohbet kuralları ---
ROUND_SECONDS=120
MAX_EXTENSIONS=2

# --- Bildirim ve yasak ---
# Bu kadar farklı kişi, REPORT_WINDOW_HOURS içinde bildirirse cihaz BAN_HOURS saat uzaklaştırılır
REPORT_BAN_THRESHOLD=3
REPORT_WINDOW_HOURS=24
BAN_HOURS=24

# --- Saklama ---
# Mesajlar yalnızca bildirimleri incelemek için bu kadar saat tutulur (72 = 3 gün)
MESSAGE_RETENTION_HOURS=72
# Sohbet kayıtları ve bildirimler (mesaj metni olmadan) bu kadar gün tutulur
RECORD_RETENTION_DAYS=30
# Bir IP adresinden saatte en fazla kaç yeni anonim kimlik oluşturulabilir
IDENTITIES_PER_IP_PER_HOUR=20
